{
  "id": "rabbitmq",
  "name": "rabbitmq",
  "displayName": "RabbitMQ",
  "description": "Robust message broker for distributed applications",
  "longDescription": "RabbitMQ is a reliable and mature messaging and streaming broker, which is easy to deploy on cloud environments, on-premises, and on your local machine.",
  "category": "message-queue",
  "tags": ["message-queue", "amqp", "messaging", "broker"],
  "icon": {
    "type": "simpleicons",
    "value": "rabbitmq",
    "color": "#FF6600"
  },
  "version": "1.0.0",
  "image": "rabbitmq",
  "imageTag": "3-management-alpine",
  "imageTags": [
    {"tag": "3-management-alpine", "label": "RabbitMQ 3 with Management UI", "recommended": true}
  ],
  "replication": {
    "canReplicate": false,
    "defaultReplicas": 1,
    "minReplicas": 1,
    "maxReplicas": 1,
    "warnings": ["RabbitMQ clustering requires special configuration"],
    "recommendations": "Use RabbitMQ cluster mode for HA"
  },
  "updateStrategy": {
    "type": "recreate"
  },
  "requiredVariables": [
    {
      "key": "RABBITMQ_DEFAULT_USER",
      "description": "RabbitMQ default username",
      "required": true
    },
    {
      "key": "RABBITMQ_DEFAULT_PASS",
      "description": "RabbitMQ default password",
      "required": true,
      "secret": true,
      "validation": {"minLength": 8}
    }
  ],
  "optionalVariables": [],
  "exposedVariables": [
    {
      "key": "RABBITMQ_URL",
      "description": "RabbitMQ connection URL",
      "formula": "amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@${service_name}:${port}",
      "dependencies": ["RABBITMQ_DEFAULT_USER", "RABBITMQ_DEFAULT_PASS"],
      "secret": true
    },
    {
      "key": "RABBITMQ_HOST",
      "description": "RabbitMQ hostname",
      "formula": "${service_name}",
      "dependencies": []
    },
    {
      "key": "RABBITMQ_PORT",
      "description": "RabbitMQ AMQP port",
      "formula": "${port}",
      "dependencies": []
    }
  ],
  "ports": [
    {"name": "amqp", "containerPort": 5672, "protocol": "tcp"},
    {"name": "management", "containerPort": 15672, "protocol": "tcp", "expose": true, "description": "Management UI"}
  ],
  "volumes": [
    {
      "name": "rabbitmq-data",
      "mountPath": "/var/lib/rabbitmq",
      "description": "RabbitMQ data",
      "sizeRecommendation": "5Gi"
    }
  ],
  "healthCheck": {
    "test": ["CMD", "rabbitmq-diagnostics", "ping"],
    "interval": 10000000000,
    "timeout": 5000000000,
    "retries": 3,
    "startPeriod": 60000000000
  },
  "resources": {
    "requests": {"cpu": "0.25", "memory": "256m"},
    "limits": {"cpu": "1", "memory": "1g"}
  },
  "documentation": {
    "officialDocs": "https://www.rabbitmq.com/documentation.html",
    "dockerHub": "https://hub.docker.com/_/rabbitmq",
    "github": "https://github.com/rabbitmq/rabbitmq-server"
  },
  "metadata": {
    "author": "Uni-Deploy",
    "license": "MPL",
    "createdAt": "2025-01-19T00:00:00Z",
    "updatedAt": "2025-01-19T00:00:00Z"
  }
}

{
  "id": "traefik",
  "name": "traefik",
  "displayName": "Traefik",
  "description": "Modern HTTP reverse proxy and load balancer",
  "longDescription": "Traefik is a modern HTTP reverse proxy and load balancer that makes deploying microservices easy. It integrates with your existing infrastructure components and configures itself automatically and dynamically.",
  "category": "web-server",
  "tags": ["reverse-proxy", "load-balancer", "cloud-native", "automatic-configuration"],
  "icon": {
    "type": "simpleicons",
    "value": "traefikproxy",
    "color": "#24A1C1"
  },
  "version": "1.0.0",
  "image": "traefik",
  "imageTag": "latest",
  "imageTags": [
    {"tag": "latest", "label": "Traefik (Latest)", "recommended": true},
    {"tag": "v2.10", "label": "Traefik 2.10"}
  ],
  "replication": {
    "canReplicate": true,
    "defaultReplicas": 1,
    "minReplicas": 1,
    "maxReplicas": 10,
    "recommendations": "Traefik can be replicated for load balancing"
  },
  "updateStrategy": {
    "type": "rolling",
    "rollingUpdate": {"maxUnavailable": 0, "maxSurge": 1}
  },
  "requiredVariables": [],
  "optionalVariables": [
    {
      "key": "TRAEFIK_API_INSECURE",
      "description": "Enable insecure API (dev only)",
      "default": "true",
      "required": false
    }
  ],
  "exposedVariables": [
    {
      "key": "TRAEFIK_HOST",
      "description": "Traefik hostname",
      "formula": "${service_name}",
      "dependencies": [],
      "example": "traefik"
    },
    {
      "key": "TRAEFIK_HTTP_PORT",
      "description": "Traefik HTTP port",
      "formula": "${port}",
      "dependencies": [],
      "example": "80"
    },
    {
      "key": "TRAEFIK_HTTPS_PORT",
      "description": "Traefik HTTPS port",
      "formula": "443",
      "dependencies": [],
      "example": "443"
    },
    {
      "key": "TRAEFIK_DASHBOARD_URL",
      "description": "Traefik dashboard URL",
      "formula": "http://${service_name}:8080",
      "dependencies": [],
      "example": "http://traefik:8080"
    }
  ],
  "ports": [
    {"name": "http", "containerPort": 80, "protocol": "tcp", "expose": true, "description": "HTTP entrypoint"},
    {"name": "https", "containerPort": 443, "protocol": "tcp", "expose": true, "description": "HTTPS entrypoint"},
    {"name": "dashboard", "containerPort": 8080, "protocol": "tcp", "expose": true, "description": "Dashboard and API"}
  ],
  "commands": [
    "--api.insecure=${TRAEFIK_API_INSECURE:-true}",
    "--providers.docker=true",
    "--providers.docker.exposedbydefault=false",
    "--entrypoints.web.address=:80",
    "--entrypoints.websecure.address=:443"
  ],
  "healthCheck": {
    "test": ["CMD", "traefik", "healthcheck", "--ping"],
    "interval": 10000000000,
    "timeout": 3000000000,
    "retries": 3,
    "startPeriod": 10000000000
  },
  "resources": {
    "requests": {"cpu": "0.1", "memory": "64m"},
    "limits": {"cpu": "0.5", "memory": "256m"},
    "profiles": [
      {"name": "small", "label": "Small", "requests": {"cpu": "0.1", "memory": "64m"}, "limits": {"cpu": "0.25", "memory": "128m"}},
      {"name": "medium", "label": "Medium", "requests": {"cpu": "0.25", "memory": "128m"}, "limits": {"cpu": "0.5", "memory": "256m"}}
    ]
  },
  "documentation": {
    "officialDocs": "https://doc.traefik.io/traefik/",
    "dockerHub": "https://hub.docker.com/_/traefik",
    "github": "https://github.com/traefik/traefik",
    "quickStart": "Access dashboard at http://localhost:8080. Configure via labels or configuration file."
  },
  "metadata": {
    "author": "Uni-Deploy",
    "license": "MIT",
    "createdAt": "2025-01-19T00:00:00Z",
    "updatedAt": "2025-01-19T00:00:00Z"
  }
}
